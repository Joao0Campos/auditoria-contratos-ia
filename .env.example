# Copie este arquivo para .env e preencha. O .env está no .gitignore e nunca deve ser versionado.

# Obrigatória: chave da API do Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcionais: descomente e preencha só se quiser sobrescrever o padrão (entre parênteses)
# Pasta com Sem_Registro.xlsx, consolidado.xlsx e as pastas de PDFs (padrão: pasta do projeto)
# AUDITORIA_DIR_BASE=
# Modelo Gemini (gemini-3.5-flash-lite)
# AUDITORIA_MODEL=
# Pausa em segundos entre contratos, para respeitar o rate limit do free tier (15)
# AUDITORIA_DELAY=
# Contratos processados em paralelo (1)
# AUDITORIA_MAX_WORKERS=
# Salvar a planilha a cada N contratos processados (15)
# AUDITORIA_SALVAR_A_CADA=
# Interromper o lote após N falhas seguidas (8)
# AUDITORIA_LIMITE_FALHAS_SEGUIDAS=
# 1 = log detalhado por contrato (0)
# AUDITORIA_VERBOSE=
